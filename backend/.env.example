# ──────────────────────────────────────────────────────────────────────────────
# SYNAPSE — Environment Configuration
# Copy this file to .env and fill in your values.
#
# ⚠️  NEVER commit .env to version control.
#     The .gitignore already excludes .env files.
# ──────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=info
SECRET_KEY=synapse-change-this-in-production-please

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default, works out of the box — great for development)
DATABASE_URL=sqlite+aiosqlite:///./synapse.db

# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql+asyncpg://synapse:password@localhost:5432/synapse

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ══════════════════════════════════════════════════════════════════════════════
# LLM PROVIDERS — Fill in at least ONE provider
# ══════════════════════════════════════════════════════════════════════════════

# Active LLM provider for specialist agents (CodeAnalyzer, SecurityScanner, etc.)
# Options: ollama | lmstudio | openai | anthropic | gemini | groq | cohere | azure | deepseek
LLM_PROVIDER=ollama
LLM_MODEL=hermes3
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_STREAMING=true
LLM_TIMEOUT=120

# ── Hermes Orchestrator (can use a different/larger model) ────────────────────
HERMES_PROVIDER=ollama
HERMES_MODEL=hermes3
HERMES_TEMPERATURE=0.2
HERMES_MAX_TOKENS=2048

# ── LOCAL LLMs ────────────────────────────────────────────────────────────────
# Ollama — https://ollama.ai
# Run: ollama pull hermes3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=hermes3

# LM Studio — https://lmstudio.ai
# Start LM Studio server before using
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model
LMSTUDIO_API_KEY=lm-studio

# ── CLOUD LLMs ────────────────────────────────────────────────────────────────
# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=  # Uncomment for custom OpenAI-compatible endpoints

# Anthropic Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini — https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-pro

# Groq (ultra-fast inference) — https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Cohere — https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
COHERE_MODEL=command-r-plus

# Azure OpenAI — https://portal.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_API_VERSION=2024-02-15-preview

# DeepSeek — https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-coder
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Nvidia NIM — https://build.nvidia.com
NVIDIA_API_KEY=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
NVIDIA_MODEL=z-ai/glm-5.1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# OpenAI Compatible Cloud LLM (e.g. OpenRouter, Together AI, etc.)
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=custom-model
OPENAI_COMPATIBLE_BASE_URL=

# ══════════════════════════════════════════════════════════════════════════════
# GITHUB INTEGRATION
# ══════════════════════════════════════════════════════════════════════════════
# Personal Access Token with: repo, pull_requests scopes
# Create at: https://github.com/settings/tokens/new
GITHUB_TOKEN=

# Webhook secret for GitHub Webhooks (optional — only needed for auto-webhook)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=

# ══════════════════════════════════════════════════════════════════════════════
# REVIEW SETTINGS
# ══════════════════════════════════════════════════════════════════════════════
AUTO_APPROVE_LOW_SEVERITY=false
REQUIRE_APPROVAL_FOR_PR=true
MAX_FILE_SIZE_KB=500
MAX_FILES_PER_REVIEW=50
REVIEW_TIMEOUT_SECONDS=300
ENABLE_AST_ANALYSIS=true
ENABLE_SECURITY_SCAN=true
ENABLE_TEST_GENERATION=true
ENABLE_FIX_SUGGESTIONS=true

# ══════════════════════════════════════════════════════════════════════════════
# WEBHOOK
# ══════════════════════════════════════════════════════════════════════════════
WEBHOOK_ENABLED=true
WEBHOOK_PATH=/api/github/webhook
